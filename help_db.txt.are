------------------------------------------------------------------------- 
ASOUND     [text_string]           ECHO       [text_string] 
GECHO      [text_string]           ZECHO      [text_string] 
ECHOAT     [victim] [text_string]  ECHOAROUND [victim] [text_string] 
MLOAD      [vnum]                  OLOAD      [vnum] [level] {{wear|room} 
KILL       [victim]                FLEE 
